<Window x:Class="SemaphoreThreads.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SemaphoreThreads"
        mc:Ignorable="d"
        Title="Threads/Semaphore"
        Height="380"
        Width="710"
        MinHeight="350"
        MinWidth="600"
        Background="#FFEAEAEA">

    <Grid Background="#FFEAEAEA" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0"
               Grid.Column="0"
               Content="Working Threads"
               HorizontalContentAlignment="Center"
               FontWeight="Bold"/>

        <Label Grid.Row="0"
               Grid.Column="1"
               Content="Waiting Threads"
               HorizontalContentAlignment="Center"
               FontWeight="Bold"/>

        <Label Grid.Row="0"
               Grid.Column="2"
               Content="Created Threads"
               HorizontalContentAlignment="Center"
               FontWeight="Bold"/>

        <ListBox x:Name="listbox1"
                 Grid.Row="1"
                 Grid.Column="0"
                 Margin="5"
                 MouseDoubleClick="listbox1_MouseDoubleClick"/>

        <ListBox x:Name="listbox2"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="5"/>

        <ListBox x:Name="listbox3"
                 Grid.Row="1"
                 Grid.Column="2"
                 Margin="5"
                 MouseDoubleClick="listbox3_MouseDoubleClick"/>

        <Label Grid.Row="2"
               Grid.Column="0"
               Content="Places In Semaphore"
               FontWeight="Bold"
               VerticalAlignment="Center"
               Margin="5,10,5,5"/>

        <Grid Grid.Row="3"
              Grid.Column="0"
              Grid.ColumnSpan="2"
              Margin="5,5,5,0">

            <TextBox x:Name="txtScroll"
                     Height="30"
                     Text="0"
                     IsReadOnly="True"
                     Padding="5,0,45,0"
                     VerticalContentAlignment="Center"/>

            <Grid Width="40"
                  Height="30"
                  HorizontalAlignment="Right">

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Content="▲"
                        FontSize="8"
                        Padding="0"
                        Click="Button_Click"/>

                <Button Grid.Row="1"
                        Content="▼"
                        FontSize="8"
                        Padding="0"
                        Click="Button_Click_1"/>

            </Grid>
        </Grid>

        <Button x:Name="createBtn"
                Grid.Row="3"
                Grid.Column="2"
                Content="Create New"
                Height="36"
                Margin="5,0,5,0"
                FontWeight="Bold"
                HorizontalAlignment="Stretch"
                Click="createBtn_Click"/>

    </Grid>
</Window>